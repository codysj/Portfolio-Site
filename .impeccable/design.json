  "narrative": {
    "northStar": "The Moonlit Workbench",
    "overview": "The site is a workbench seen at night: built, tactile objects lit by soft moonlight and one warm lamp. The hero is the workbench itself, a finite sage Minesweeper board set into a dark green voxel wall. Visitors can press it, flag it and reset it, and they can also ignore it and keep scrolling. Everything below the hero is the bench's notebook: quiet serif headings, monospaced annotations, hairline rules and measured numbers.\n\nThe craft is meant to be visible but never loud. Depth and material belong to the 3D scene (beveled solid geometry, warm diffuse light, restrained shadows). The HTML layer stays flat, dark and translucent, so it reads like light falling on the bench, not like objects competing with it. Color is almost all moonlit green-gray. Warmth comes in small, deliberate doses: the italic accent word, the brass counters, the yellow buddy disc and the coral flags.\n\nDensity is low and the pace is calm. Sections breathe on generous fluid padding, text measures stay between 48 and 68 characters, and motion is limited to short entrances, small lifts on hover and the game's own feedback.",
    "keyCharacteristics": [
      "Dark only. A deep forest-night gradient runs from the hero down to the page floor.",
      "Newsreader light serif for anything that is named; IBM Plex Mono for everything that is read or labeled.",
      "Sage-tinted translucent fills with hairline borders. No solid UI color blocks.",
      "Nearly square corners (2–3px). Circles are reserved for objects you press (the buddy disc, card arrows, the status dot).",
      "One tactile 3D object (the board) carries all the depth; the HTML stays flat."
    ],
    "rules": [
      {
        "name": "The Moonlight Rule",
        "body": "HTML UI color is sage-tinted and translucent. Fills are `rgba(154,211,176, ≤0.2)` over the dark ground, never a saturated or solid block. Bright color lives only inside the 3D scene.",
        "section": "colors"
      },
      {
        "name": "The Lamp Rule",
        "body": "Warm color (Lamplight, Counter Brass, Buddy Yellow, Coral Flag) is rationed: one italic accent word per headline in HTML, and game-state objects in the scene. It is never used for decoration.",
        "section": "colors"
      },
      {
        "name": "The Borrowed Brand Rule",
        "body": "Third-party brand colors (YC orange `yc-orange`, AfterQuery's black tile, the Mastercard and Google marks) appear only inside their own logo or badge, at logo size.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Newsreader is for names (people, sections, companies, projects). Plex Mono is for everything else, including long-form body copy. Never set a button, label or number in the serif, and never set a heading in mono.",
        "section": "typography"
      },
      {
        "name": "The Wide Label Rule",
        "body": "Every uppercase label is tracked out (minimum 0.08em) and kept at 12px or below. Uppercase is never used for sentences.",
        "section": "typography"
      },
      {
        "name": "The Measure Rule",
        "body": "Text never runs full width: 16ch for display, 48–68ch for body. Wide viewports get more air, not longer lines.",
        "section": "layout"
      },
      {
        "name": "The Flat-Page Rule",
        "body": "HTML surfaces have no drop shadows at rest. A shadow or glow appears only as a response to state (hover, live status) or to keep scene-overlaid text legible.",
        "section": "elevation"
      },
      {
        "name": "The One Object Rule",
        "body": "The board is the only object with physical depth. New UI never imitates it with fake bevels or 3D effects in CSS.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep HTML fills to Sage Wash at 0.2 alpha or less, with 1px hairline borders (the Moonlight Rule).",
      "Do set names in Newsreader 300/400 and everything else in IBM Plex Mono (the Two Voices Rule).",
      "Do give every interactive element a 2px Moonlit Leaf `:focus-visible` outline.",
      "Do keep hover feedback small: a 1px lift, a 3px arrow slide, or a border brightening over 0.2–0.25s.",
      "Do keep the HTML content stable while the scene's effects run, and keep native page scrolling (including one-finger drag) available over the hero.",
      "Do keep all game-state feedback under `prefers-reduced-motion`, and turn off reveals, the scroll-bar pulse and sprite previews there.",
      "Do keep the game playable without a mouse, through the single-entry keyboard grid."
    ],
    "donts": [
      "Don't introduce bright, saturated, or solid color blocks in the HTML UI. Saturated color belongs to the 3D scene and to third-party logos at logo size.",
      "Don't add continuous orbiting, flashing overlays, or decorative motion that competes with reading.",
      "Don't give the HTML layer drop shadows, fake bevels, or CSS 3D. The board is the one physical object.",
      "Don't add labels to the hero counters or extra controls above the board.",
      "Don't introduce a second game input system without preserving the single-entry keyboard grid.",
      "Don't pass the hidden mine layout to the renderer or the companion."
    ]
  }
