      "html": "<a class=\"ds-card-link\" href=\"#\">View on GitHub <span class=\"ds-arrow\">→</span></a>",
      "css": ".ds-card-link{display:inline-flex;align-items:center;gap:9px;font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#b3ccb6;text-decoration:none;border-bottom:1px solid rgba(154,211,176,0.4);padding-bottom:3px;transition:color .25s ease,border-color .25s ease;}.ds-card-link:hover{color:#bad6ae;border-color:#bad6ae;}.ds-card-link:focus-visible{outline:2px solid #bad6ae;outline-offset:4px;}.ds-card-link .ds-arrow{transition:transform .25s ease;}.ds-card-link:hover .ds-arrow{transform:translateX(3px);}"
